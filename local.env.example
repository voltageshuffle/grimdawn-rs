# Machine-local settings. Copy to `local.env` (gitignored) and edit, then either
# `source local.env` in your shell or prefix commands with `scripts/with-env`.

# The Grim Dawn install (the folder holding `database/database.arz`). Required by `cargo dev` and the data tests.
# One folder per game version, named by it (`gd_1_3_1_2`); keep the previous one only while porting an update.
export GD_ROOT="/path/to/games/gd_<version>"

# Optional: where the port writes its saves (default `$XDG_DATA_HOME/grimdawn-rs/save`).
# export GD_SAVE_DIR="/path/to/saves"

# Optional: a character to load on `cargo dev` (smoke runs).
# export GD_SAVE="/path/to/player.gdc"

# Optional: the reverse-engineering folder outside the repo (IDA databases, decompile notes, extracted data),
# one subfolder per game version (`1_3_1_2`). Point it at the version GD_ROOT holds.
# export GD_RE_DIR="/path/to/re/<version>"

# Optional: skip the tests that read the install (a machine without the game).
# export GD_SKIP_DATA_TESTS=1
